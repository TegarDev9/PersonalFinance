{
  "openapi": "3.0.3",
  "info": {
    "title": "FinDash API",
    "version": "1.0.0",
    "description": "Personal finance, trading, sentiment, AI and n8n integration API.\n\nNotes:\n- Write endpoints persist only when KV is configured (Vercel KV / Upstash). On serverless without KV, data may be ephemeral.\n- Logs endpoints can be protected via LOGS_AUTH_TOKEN and accept token via query (?token=), header (X-Logs-Token) or Authorization: Bearer."
  },
  "servers": [
    { "url": "http://localhost:3000" },
    { "url": "https://your-app.vercel.app" }
  ],
  "tags": [
    { "name": "Wallet", "description": "Accounts, transactions, holdings, and summaries." },
    { "name": "Categories", "description": "Spending categories and hierarchy." },
    { "name": "Budgets", "description": "Monthly budgets per category and operations." },
    { "name": "Rules", "description": "Auto-categorization rules with keywords, amounts, accounts, and regex." },
    { "name": "Reports", "description": "Budget progress and overspending reports." },
    { "name": "Import/Export", "description": "CSV/QIF/OFX exports and bulk ZIP; transactions import." },
    { "name": "Sentiment", "description": "VADER, Google NLP, FinBERT, and Finnhub sentiment analysis." },
    { "name": "n8n", "description": "Webhook intake, log viewing/streaming, and log management." }
  ],
  "x-tagGroups": [
    { "name": "Wallet & Portfolio", "tags": ["Wallet"] },
    { "name": "Budgeting", "tags": ["Categories", "Budgets", "Rules", "Reports"] },
    { "name": "Import & Export", "tags": ["Import/Export"] },
    { "name": "Sentiment", "tags": ["Sentiment"] },
    { "name": "Automation (n8n)", "tags": ["n8n"] }
  ],
  "components": {
    "securitySchemes": {
      "logsTokenQuery": { "type": "apiKey", "in": "query", "name": "token" },
      "logsTokenHeader": { "type": "apiKey", "in": "header", "name": "X-Logs-Token" },
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["cash","bank","brokerage","credit"] },
          "balance": { "type": "number" }
        },
        "required": ["id","name","type","balance"]
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "accountId": { "type": "string" },
          "type": { "type": "string", "enum": ["income","expense","transfer"] },
          "category": { "type": "string" },
          "categoryId": { "type": "string" },
          "amount": { "type": "number" },
          "note": { "type": "string" }
        },
        "required": ["id","date","accountId","type","amount"]
      },
      "Holding": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "symbol": { "type": "string" },
          "quantity": { "type": "number" },
          "avgPrice": { "type": "number" }
        },
        "required": ["id","symbol"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["income","expense","transfer"] },
          "parentId": { "type": "string", "nullable": true }
        },
        "required": ["id","name","type"]
      },
      "Budget": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "categoryId": { "type": "string" },
          "month": { "type": "string", "example": "2025-01" },
          "amount": { "type": "number" }
        },
        "required": ["id","categoryId","month","amount"]
      },
      "Rule": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "categoryId": { "type": "string" },
          "type": { "type": "string", "enum": ["income","expense","transfer"] },
          "priority": { "type": "integer" },
          "amountMin": { "type": "number" },
          "amountMax": { "type": "number" },
          "accounts": { "type": "array", "items": { "type": "string" } },
          "regex": { "type": "string" },
          "regexFlags": { "type": "string" }
        },
        "required": ["id","name","categoryId"]
      },
      "BudgetReportItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "categoryId": { "type": "string" },
          "categoryName": { "type": "string" },
          "month": { "type": "string" },
          "budget": { "type": "number" },
          "spent": { "type": "number" },
          "remaining": { "type": "number" },
          "percent": { "type": "number" }
        }
      }
    }
  },
  "paths": {
    "/api/wallet/summary": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Get wallet summary",
        "x-codeSamples": [
          { "lang": "curl", "label": "curl", "source": "curl -s $BASE/api/wallet/summary" },
          { "lang": "JavaScript", "label": "fetch", "source": "const BASE='https://your-app.vercel.app';\nconst res=await fetch(`${BASE}/api/wallet/summary`);\nconst data=await res.json();\nconsole.log(data);" },
          { "lang": "TypeScript", "label": "fetch", "source": "const BASE='https://your-app.vercel.app';\ntype Summary={currency:string;totals:{cash:number;invested:number;netWorth:number};counts:{accounts:number;transactions:number;holdings:number}};\nconst res=await fetch(`${BASE}/api/wallet/summary`);\nconst data=await res.json() as Summary;" },
          { "lang": "Python", "label": "requests", "source": "import requests\nBASE='https://your-app.vercel.app'\nr=requests.get(f'{BASE}/api/wallet/summary')\nprint(r.json())" }
      ],

        "responses": {
          "200": {
            "description": "Summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "currency": { "type": "string" },
                    "totals": {
                      "type": "object",
                      "properties": {
                        "cash": { "type": "number" },
                        "invested": { "type": "number" },
                        "netWorth": { "type": "number" }
                      }
                    },
                    "counts": {
                      "type": "object",
                      "properties": {
                        "accounts": { "type": "number" },
                        "transactions": { "type": "number" },
                        "holdings": { "type": "number" }
                      }
                    }
                  }
                },
                "example": {
                  "currency": "USD",
                  "totals": { "cash": 1234.56, "invested": 2000, "netWorth": 3234.56 },
                  "counts": { "accounts": 2, "transactions": 12, "holdings": 1 }
                }
              }
            }
          }
        }
      }
    },
    "/api/wallet/accounts": {
      "get": {
        "tags": ["Wallet"],
        "summary": "List accounts",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -s $BASE/api/wallet/accounts" }
        ],
        "responses": {
          "200": {
            "description": "Array of accounts",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } } } }
          }
        }
      },
      "post": {
        "tags": ["Wallet"],
        "summary": "Create account",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -X POST $BASE/api/wallet/accounts -H 'content-type: application/json' -d '{\"name\":\"Cash 2\",\"type\":\"cash\",\"balance\":0}'" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "balance": { "type": "number" } }, "required": ["name"] } } }
        },
        "responses": {
          "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } }
        }
      }
    },
    "/api/wallet/accounts/{id}": {
      "patch": {
        "tags": ["Wallet"],
        "summary": "Update account",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -X PATCH $BASE/api/wallet/accounts/acc_123 -H 'content-type: application/json' -d '{\"name\":\"Primary Cash\"}'" }
        ],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } },
        "responses": { "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } } }
      },
      "delete": {
        "tags": ["Wallet"],
        "summary": "Delete account",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -X DELETE $BASE/api/wallet/accounts/acc_123" }
        ],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/wallet/transactions": {
      "get": {
        "tags": ["Wallet"],
        "summary": "List transactions",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -s \"$BASE/api/wallet/transactions?accountId=acc_cash&month=2025-01&limit=10\"" }
        ],
        "parameters": [
          { "in": "query", "name": "accountId", "schema": { "type": "string" } },
          { "in": "query", "name": "category", "schema": { "type": "string" } },
          { "in": "query", "name": "type", "schema": { "type": "string", "enum": ["income","expense","transfer"] } },
          { "in": "query", "name": "month", "schema": { "type": "string", "example": "2025-01" } },
          { "in": "query", "name": "startMonth", "schema": { "type": "string" } },
          { "in": "query", "name": "endMonth", "schema": { "type": "string" } },
          { "in": "query", "name": "startDate", "schema": { "type": "string", "format": "date" } },
          { "in": "query", "name": "endDate", "schema": { "type": "string", "format": "date" } },
          { "in": "query", "name": "minAmount", "schema": { "type": "number" } },
          { "in": "query", "name": "maxAmount", "schema": { "type": "number" } },
          { "in": "query", "name": "limit", "schema": { "type": "integer", "default": 100 } }
        ],
        "responses": { "200": { "description": "Array of transactions", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } } } } } }
      },
      "post": {
        "tags": ["Wallet"],
        "summary": "Create transaction",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -X POST $BASE/api/wallet/transactions -H 'content-type: application/json' -d '{\"date\":\"2025-01-12\",\"accountId\":\"acc_cash\",\"type\":\"expense\",\"category\":\"Food & Dining\",\"amount\":-12.5,\"note\":\"Lunch\"}'" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "date": { "type": "string", "format": "date" }, "accountId": { "type": "string" }, "type": { "type": "string" }, "category": { "type": "string" }, "categoryId": { "type": "string" }, "amount": { "type": "number" }, "note": { "type": "string" } }, "required": ["date","accountId","type","amount"] } } }
        },
        "responses": { "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaction" } } } } }
      }
    },
    "/api/wallet/holdings": {
      "get": {
        "tags": ["Wallet"], "summary": "List holdings",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -s $BASE/api/wallet/holdings" }
        ],
        "responses": { "200": { "description": "Array", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Holding" } } } } } }
      },
      "post": {
        "tags": ["Wallet"], "summary": "Create holding",
        "x-codeSamples": [
          { "lang": "curl", "source": "curl -X POST $BASE/api/wallet/holdings -H 'content-type: application/json' -d '{\"symbol\":\"AAPL\",\"quantity\":10,\"avgPrice\":150}'" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "symbol": { "type": "string" }, "quantity": { "type": "number" }, "avgPrice": { "type": "number" } }, "required": ["symbol"] } } } },
        "responses": { "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Holding" } } } } }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Categories"], "summary": "List categories",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -s $BASE/api/categories" }],
        "responses": { "200": { "description": "Array", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } } } }
      },
      "post": {
        "tags": ["Categories"], "summary": "Create category",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X POST $BASE/api/categories -H 'content-type: application/json' -d '{\"name\":\"Transport\",\"type\":\"expense\"}'" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "parentId": { "type": "string" } }, "required": ["name"] } } } },
        "responses": { "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } } }
      }
    },
    "/api/categories/{id}": {
      "patch": {
        "tags": ["Categories"], "summary": "Update category",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X PATCH $BASE/api/categories/cat_123 -H 'content-type: application/json' -d '{\"name\":\"Food & Dining\"}'" }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } },
        "responses": { "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } } } }
      },
      "delete": {
        "tags": ["Categories"], "summary": "Delete category",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X DELETE $BASE/api/categories/cat_123" }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/categories/restore": {
      "post": {
        "tags": ["Categories"], "summary": "Restore a deleted category with budgets",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X POST $BASE/api/categories/restore -H 'content-type: application/json' -d '{\"category\":{\"id\":\"cat_old\",\"name\":\"Old Cat\",\"type\":\"expense\"},\"budgets\":[{\"id\":\"bud_old\",\"categoryId\":\"cat_old\",\"month\":\"2025-01\",\"amount\":200}]}'" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "category": { "$ref": "#/components/schemas/Category" }, "budgets": { "type": "array", "items": { "$ref": "#/components/schemas/Budget" } } }, "required": ["category"] } } } },
        "responses": { "200": { "description": "Restored" } }
      }
    },
    "/api/budgets": {
      "get": {
        "tags": ["Budgets"], "summary": "List budgets (optionally filter by month)",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -s \"$BASE/api/budgets?month=2025-01\""}],
        "parameters": [{ "in": "query", "name": "month", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Array", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Budget" } } } } } }
      },
      "post": {
        "tags": ["Budgets"], "summary": "Create budget",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X POST $BASE/api/budgets -H 'content-type: application/json' -d '{\"categoryId\":\"cat_food\",\"month\":\"2025-01\",\"amount\":300}'" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "categoryId": { "type": "string" }, "month": { "type": "string" }, "amount": { "type": "number" } }, "required": ["categoryId","month"] } } } },
        "responses": { "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Budget" } } } } }
      }
    },
    "/api/budgets/{id}": {
      "patch": {
        "tags": ["Budgets"], "summary": "Update budget",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X PATCH $BASE/api/budgets/bud_123 -H 'content-type: application/json' -d '{\"amount\":450}'" }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Budget" } } } },
        "responses": { "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Budget" } } } } }
      },
      "delete": {
        "tags": ["Budgets"], "summary": "Delete budget",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X DELETE $BASE/api/budgets/bud_123" }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/budgets/restore": {
      "post": {
        "tags": ["Budgets"], "summary": "Restore budget",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X POST $BASE/api/budgets/restore -H 'content-type: application/json' -d '{\"budget\":{\"id\":\"bud_old\",\"categoryId\":\"cat_food\",\"month\":\"2025-01\",\"amount\":300}}'"}],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "budget": { "$ref": "#/components/schemas/Budget" } }, "required": ["budget"] } } } },
        "responses": { "200": { "description": "Restored" } }
      }
    },
    "/api/rules": {
      "get": {
        "tags": ["Rules"], "summary": "List rules",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -s $BASE/api/rules" }],
        "responses": { "200": { "description": "Array", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Rule" } } } } } }
      },
      "post": {
        "tags": ["Rules"], "summary": "Create rule",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X POST $BASE/api/rules -H 'content-type: application/json' -d '{\"name\":\"Food keywords\",\"keywords\":[\"food\",\"restaurant\"],\"categoryId\":\"cat_food\",\"type\":\"expense\",\"priority\":10}'" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rule" } } } },
        "responses": { "200": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rule" } } } } }
      }
    },
    "/api/rules/{id}": {
      "patch": {
        "tags": ["Rules"], "summary": "Update rule",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X PATCH $BASE/api/rules/rule_123 -H 'content-type: application/json' -d '{\"priority\":20}'" }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rule" } } } },
        "responses": { "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rule" } } } } }
      },
      "delete": {
        "tags": ["Rules"], "summary": "Delete rule",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X DELETE $BASE/api/rules/rule_123" }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/reports/budget": {
      "get": {
        "tags": ["Reports"], "summary": "Budget report for a month",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -s \"$BASE/api/reports/budget?month=2025-01\""}],
        "parameters": [{ "in": "query", "name": "month", "required": true, "schema": { "type": "string", "example": "2025-01" } }],
        "responses": {
          "200": {
            "description": "Report",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "month": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/BudgetReportItem" } } } } } }
          }
        }
      }
    },
    "/api/budget/overspend": {
      "get": {
        "tags": ["Reports"], "summary": "Overspending list for a month",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -s \"$BASE/api/budget/overspend?month=2025-01\""}],
        "parameters": [{ "in": "query", "name": "month", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Overs", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/import/transactions": {
      "post": {
        "tags": ["Import/Export"],
        "summary": "Import transactions (CSV/OFX/QIF parsed on client)",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -X POST $BASE/api/import/transactions -H 'content-type: application/json' -d '{\"records\":[{\"date\":\"2025-01-02\",\"account\":\"Cash\",\"type\":\"expense\",\"amount\":-5.25\",\"description\":\"Coffee\"}],\"mapping\":{\"date\":\"date\",\"account\":\"account\",\"type\":\"type\",\"amount\":\"amount\",\"description\":\"description\"},\"autoCategorize\":true}'"}],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "records": { "type": "array", "items": { "type": "object" } }, "mapping": { "type": "object" }, "autoCategorize": { "type": "boolean", "default": true } }, "required": ["records"] } } }
        },
        "responses": { "200": { "description": "Import result", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/export/transactions.csv": {
      "get": {
        "tags": ["Import/Export"], "summary": "Export CSV",
        "x-codeSamples": [{ "lang": "curl", "source": "curl -L \"$BASE/api/export/transactions.csv?accountId=acc_cash&month=2025-01\"" }],
        "parameters": [
          { "in": "query", "name": "accountId", "schema": { "type": "string" } },
          { "in": "query", "name": "month", "schema": { "type": "string" } },
          { "in": "query", "name": "startMonth", "schema": { "type": "string" } },
          { "in": "query", "name": "endMonth", "schema": { "type": "string" } },
          { "in": "query", "name": "startDate", "schema": { "type": "string", "format": "date" } },
